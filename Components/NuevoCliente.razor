@page "/nuevo-cliente"
@using FerreteriaApp.Models
@inject FerreteriaDbContext DbContext
@inject NavigationManager Nav

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-success text-white">
            <h4><i class="bi bi-person-plus"></i> Registrar Nuevo Cliente</h4>
        </div>
        <div class="card-body">
            <EditForm Model="cliente" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">Nombre</label>
                    <InputText @bind-Value="cliente.Nombre" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Apellido</label>
                    <InputText @bind-Value="cliente.Apellido" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Teléfono</label>
                    <InputText @bind-Value="cliente.Telefono" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Correo Electrónico</label>
                    <InputText @bind-Value="cliente.Correo" class="form-control" />
                </div>

                <div class="d-flex justify-content-end">
                    <button type="button" class="btn btn-secondary me-2" @onclick='() => Nav.NavigateTo("/clientes")'>Cancelar</button>
                    <button type="submit" class="btn btn-success">Guardar Cliente</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private Cliente cliente = new();

    private async Task Guardar()
    {
        DbContext.Clientes.Add(cliente);
        await DbContext.SaveChangesAsync();
        Nav.NavigateTo("/clientes"); // Regresa a la lista después de guardar
    }
}