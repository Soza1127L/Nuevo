@page "/clientes"
@using FerreteriaApp.Models

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Gestión de Clientes</h2>
        <button class="btn btn-success px-4 shadow-sm">
            <i class="oi oi-plus me-2"></i> Nuevo Cliente
        </button>
    </div>

    <!-- Buscador -->
    <div class="input-group mb-4 shadow-sm">
        <span class="input-group-text bg-white border-end-0">
            <i class="oi oi-magnifying-glass text-muted"></i>
        </span>
        <input type="text" class="form-control border-start-0" 
               placeholder="Buscar por nombre o apellido..." 
               @bind="searchTerm" @bind:event="oninput" />
    </div>

    <!-- Tabla de Clientes -->
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Nombre</th>
                        <th>Apellido</th>
                        <th>Teléfono</th>
                        <th>Correo</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (FilteredClientes != null && FilteredClientes.Any())
                    {
                        @foreach (var cliente in FilteredClientes)
                        {
                            <tr>
                                <td class="ps-4">@cliente.Nombre</td>
                                <td>@cliente.Apellido</td>
                                <td>@(cliente.Telefono ?? "N/A")</td>
                                <td>@(cliente.Correo ?? "N/A")</td>
                                <td>
                                    @if (cliente.Estado == true)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactivo</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group shadow-sm">
                                        <button class="btn btn-outline-primary btn-sm">
                                            <i class="oi oi-pencil"></i>
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm">
                                            <i class="oi oi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="oi oi-info me-2"></i> No se encontraron clientes.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private string searchTerm = "";
    private List<Cliente> clientes = new List<Cliente>();

    protected override async Task OnInitializedAsync()
    {
        clientes = new List<Cliente>()
        {
            new Cliente { IdCliente=1, Nombre="Juan", Apellido="Pérez", Telefono="8888-0000", Estado=true },
            new Cliente { IdCliente=2, Nombre="Ana", Apellido="García", Correo="ana@mail.com", Estado=true },
            new Cliente { IdCliente=3, Nombre="Roberto", Apellido="Sánchez", Estado=false }
        };

        await Task.CompletedTask;
    }

    private IEnumerable<Cliente> FilteredClientes => 
        clientes.Where(c => 
            string.IsNullOrWhiteSpace(searchTerm) || 
            (c.Nombre != null && c.Nombre.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) || 
            (c.Apellido != null && c.Apellido.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        );
}